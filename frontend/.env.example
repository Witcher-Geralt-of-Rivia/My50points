# --- Desarrollo local ---------------------------------------------------
# En Windows conviene 127.0.0.1 en vez de localhost (evita EACCES por IPv6
# cuando Next hace fetch desde el servidor).
#
# Apunta al backend que levantes en local con `python run.py`.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
API_BACKEND_URL=http://127.0.0.1:8000

# Para trabajar contra el backend ya desplegado en lugar de uno local,
# comenta las dos líneas anteriores y descomenta estas:
# NEXT_PUBLIC_API_URL=https://backend-production-7512.up.railway.app
# API_BACKEND_URL=https://backend-production-7512.up.railway.app

# --- Producción (Vercel) -------------------------------------------------
# API_BACKEND_URL se define como variable de entorno del proyecto en Vercel,
# NO en este archivo, y debe apuntar al backend de Railway.

# --- Administración ------------------------------------------------------
# Solo para endpoints protegidos. Debe coincidir con ADMIN_SECRET del backend.
NEXT_PUBLIC_ADMIN_SECRET=change-me-admin-secret
